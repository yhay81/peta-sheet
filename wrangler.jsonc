{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peta-sheet",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["53 18 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peta-sheet",
      "database_id": "e8b4f522-2d23-4136-a3a4-7b3484d6c471",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
